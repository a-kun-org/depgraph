{
  "name": "depgraph",
  "version": "1.0.0",
  "description": "Local web tool for visualizing code dependency graphs across C#, Dart, and Python",
  "type": "module",
  "bin": {
    "depgraph": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/web dist/web",
    "start": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dependency",
    "graph",
    "architecture",
    "static-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "playwright": "^1.51.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
